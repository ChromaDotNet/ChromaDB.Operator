<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<IsPackable>false</IsPackable>
		<RootNamespace>ChromaDotNet.Operator</RootNamespace>
		<InvariantGlobalization>true</InvariantGlobalization>
		<!-- The name ChromaDotNet.Operator is decided: Operator is a keyword of Visual Basic only. -->
		<NoWarn>$(NoWarn);CA1716</NoWarn>
		<!-- The manifests are generated by build/manifest.sh, not at each Release build. -->
		<GenerateOperatorResources>false</GenerateOperatorResources>
		<!-- The packages of the operator, with their hashes, in packages.lock.json. The CI restores them as the lock says, and fails
		     when the lock is out of date; elsewhere, as in the build of the image, a restore can add what a runtime needs. -->
		<RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
		<RestoreLockedMode Condition="'$(CI)' == 'true'">true</RestoreLockedMode>
	</PropertyGroup>
	<ItemGroup>
		<!-- ASP.NET Core for the endpoint of the probes of the Deployment. -->
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
		<PackageReference Include="KubeOps.Operator" Version="$(KubeOpsVersion)" />
		<PackageReference Include="KubeOps.Generator" Version="$(KubeOpsVersion)" PrivateAssets="all" />
		<!-- The checks of the external Postgres and bucket of a distributed Chroma, before anything starts. -->
		<PackageReference Include="AWSSDK.S3" Version="4.0.104.6" />
		<PackageReference Include="Npgsql" Version="10.0.3" />
	</ItemGroup>
	<ItemGroup>
		<!-- The config files of distributed Chroma, by version, from build/chart.sh: Distributed/<tag>/<file>, with / or \ by system. -->
		<EmbeddedResource Include="Distributed\**\*.yaml" LogicalName="Distributed/%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>
	<ItemGroup>
		<InternalsVisibleTo Include="ChromaDotNet.Operator.Tests" />
		<InternalsVisibleTo Include="ChromaDotNet.Operator.E2E" />
	</ItemGroup>
</Project>
