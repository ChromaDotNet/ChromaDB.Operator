<Project>
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<LangVersion>latest</LangVersion>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
		<AnalysisLevel>latest-recommended</AnalysisLevel>
		<KubeOpsVersion>13.3.4</KubeOpsVersion>
		<Authors>ChromaDotNet contributors</Authors>
		<Copyright>Copyright (c) ChromaDotNet contributors</Copyright>
		<PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
		<RepositoryUrl>https://github.com/ChromaDotNet/ChromaDB.Operator</RepositoryUrl>
	</PropertyGroup>
</Project>
